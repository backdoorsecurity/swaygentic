# Copy to ~/.config/wayvnc/env and edit, then:
#   systemctl --user restart wayvnc
#
# Not swaygentrc config.py / start_server.sh — those own the phone HTTP API only.
# wayvnc is a separate user service (Haven VIEW).

# Capture output name (sway)
WAYVNC_OUTPUT=Virtual-1

# Listen (default: first Tailscale IPv4). Port default 5900.
# WAYVNC_HOST=100.81.37.71
WAYVNC_PORT=5900

# Option 1 defaults — less bandwidth / snappier over Tailscale
WAYVNC_MAX_FPS=15
WAYVNC_DISABLE_RESIZING=1

# Option 2 later (optional): shrink the desktop itself in sway, e.g.
#   swaymsg output Virtual-1 mode 1024x768
# WAYVNC_SWAY_MODE=1024x768

# Builder headless wayvnc (forge/loom): port 5$UID on loopback
#   forge (1005) → WAYVNC_PORT=51005  WAYVNC_HOST=127.0.0.1
#   loom  (1006) → WAYVNC_PORT=51006  WAYVNC_HOST=127.0.0.1
# Brave DevTools for builders: SWG_DEBUG_PORT=6$UID (61005 / 61006)
