# Agent Brave profile (isolated; never commit)
profiles/*
!profiles/.gitkeep

# Secrets / runtime
run/*
!run/.gitkeep
swaygentrc/server/run/*
!swaygentrc/server/run/.gitkeep
.env
.env.*
!.env.example
.grok
update-github.sh

# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/
env/

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
*.swp
*~
.idea/
.vscode/

# Logs / caches
*.log
.cache/
tmp/

# Android — source under swaygentrc/android/ is tracked (open source).
# Ignore only machine-local / build outputs; keep gradle wrapper + src/.
swaygentrc/android/local.properties
swaygentrc/android/.gradle/
swaygentrc/android/.kotlin/
swaygentrc/android/.cxx/
swaygentrc/android/captures/
swaygentrc/android/.idea/
swaygentrc/android/*.iml
swaygentrc/android/app/*.iml
swaygentrc/android/**/build/
swaygentrc/android/apks/*
!swaygentrc/android/apks/.gitkeep

# Local scratch / binaries that must not ship
host-full.png
shell2.exe
*.exe
# Built APKs stay out of git except the release under swaygentrc/app/
*.apk
!swaygentrc/app/swaygentrc_v*.apk

# dev files
HANDOFF.md
SCOPE.md
swaygentrc/SWAYGENTRC.md
