# Agent Brave profile (isolated; never commit)
profiles/*
!profiles/.gitkeep

# Secrets / runtime
run/*
!run/.gitkeep
swaygentrc/server/run/*
!swaygentrc/server/run/.gitkeep
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.venv-winctl/
venv/

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
*.swp
*~
.idea/
.vscode/

# Logs / caches
*.log
.cache/
tmp/

# Android build outputs (ship release APK under swaygentrc/app/ only)
swaygentrc/android/local.properties
swaygentrc/android/.gradle/
swaygentrc/android/app/build/
swaygentrc/android/vernacular/build/
swaygentrc/android/apks/*
!swaygentrc/android/apks/.gitkeep

# Local scratch / binaries that must not ship
host-full.png
shell2.exe
*.exe
*.apk
!swaygentrc/app/swaygentrc_v*.apk
